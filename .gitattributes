# 统一 LF，防止 Windows CRLF 污染 frontmatter 解析与 JSON diff
* text=auto

# 本文件自己也必须是 LF，否则 CRLF 会让下面的匹配规则解析出错
.gitattributes  text eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf

# Astro 工程（2026-11 迁移引入）：同样锁 LF，
# 否则 Windows 上改过的 .ts/.astro 到 Linux 构建机换行不一致，diff 与产物都会抖。
*.ts     text eol=lf
*.tsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.astro  text eol=lf
*.svelte text eol=lf
*.styl   text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.atlas  text eol=lf

# 钩子脚本必须是 LF：CRLF 会让 sh 报 "bad interpreter" / $'\r' 之类的错，
# 而 core.autocrlf=true 时 text=auto 会把它转成 CRLF，所以这里显式锁死。
.githooks/**  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff2 binary
*.otf   binary
*.ttf   binary
*.mp3   binary
*.wav   binary
*.moc   binary
*.spine binary
*.mtn   binary
*.bcmap binary
*.onnx  binary
*.pdf   binary
*.xlsx  binary
