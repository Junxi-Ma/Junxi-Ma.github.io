# 统一 LF，防止 Windows CRLF 污染 frontmatter 解析与 JSON diff
* text=auto

# 本文件自己也必须是 LF，否则 CRLF 会让下面的匹配规则解析出错
.gitattributes  text eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf

# 钩子脚本必须是 LF：CRLF 会让 sh 报 "bad interpreter" / $'\r' 之类的错，
# 而 core.autocrlf=true 时 text=auto 会把它转成 CRLF，所以这里显式锁死。
.githooks/**  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
