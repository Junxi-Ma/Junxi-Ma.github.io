# pnpm 配置
#
# manage-package-manager-versions：让 corepack 按 package.json 的
# packageManager 字段（pnpm@11.22.0）自动切换版本，本地与 CI 一致。
manage-package-manager-versions = true

# strict-peer-dependencies：模板的 @astrojs/cloudflare 声明 peer astro@^7.4.0，
# 而本项目锁定 astro@7.3.2。CI 上按严格模式会直接装不上，这里放宽为警告。
# 本站部署在 GitHub Pages，不用 Cloudflare adapter，该 peer 冲突不影响功能。
strict-peer-dependencies = false
